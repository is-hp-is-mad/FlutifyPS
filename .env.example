# FlutifyPS 凭据模板 —— 复制为 .env 后填写（或直接 node scripts/gen-env.js 一键生成）
# 优先级：环境变量 > .env > config.json；.env 权限建议 chmod 600，切勿提交到仓库

# ---- 必填：鉴权凭据（请求头 X-Proxy-User / X-Proxy-Pass 的值）----
PROXY_AUTH_USERNAME=
PROXY_AUTH_PASSWORD=
# 密码至少 8 个字符且不能是纯数字；生成器默认生成 32 字符随机密码。

# ---- 建议：伪装路径（URL 首段；默认 media-assets 不够安全）----
PROXY_DISGUISE_PATH=

# ---- 可选覆盖（默认取 config.json）----
# PROXY_LISTEN_HOST=0.0.0.0
# PROXY_LISTEN_PORT=443
# PROXY_HTTP_REDIRECT_PORT=0
# PROXY_PUBLIC_ORIGIN=https://music.example.com
# PROXY_UPSTREAM_PROXY=socks5://127.0.0.1:40000
# PROXY_TLS_KEY=cert/server.key
# PROXY_TLS_CERT=cert/server.crt
# PROXY_TLS_PASSPHRASE=
# PROXY_AUTH_USER_HEADER=X-Proxy-User
# PROXY_AUTH_PASS_HEADER=X-Proxy-Pass
# PROXY_LOG_LEVEL=warn
